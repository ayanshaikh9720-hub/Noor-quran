<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.NoorQuran" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/emerald_primary</item>
        <item name="colorPrimaryVariant">@color/emerald_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:statusBarColor">@color/emerald_primary</item>
        <item name="android:navigationBarColor">@color/background_light</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Theme.NoorQuran.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:statusBarColor">@color/emerald_primary</item>
    </style>
</resources>
